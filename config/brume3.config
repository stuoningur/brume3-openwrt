# ============================================================================
#  GL.iNet GL-MT5000 (Brume 3) – OpenWrt so nah wie möglich am Standard-Image
#  Basis: OpenWrt main 46e6335 + patches/ (PR #24237 + Review-Fixes, Kernel 6.18)
#  Wird von "make defconfig" vervollständigt. Nur Zielgerät + LuCI, wie bei
#  den offiziellen Release-Images.
# ============================================================================

# ---- Zielgerät ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y

# ---- Build-Beschleunigung (ändert nichts am Image) ----
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---- Weboberfläche (in offiziellen Release-Images enthalten) ----
CONFIG_PACKAGE_luci=y
