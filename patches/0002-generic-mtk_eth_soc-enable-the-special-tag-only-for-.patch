+From: stuoningur <50464069+stuoningur@users.noreply.github.com>
+Subject: [PATCH] net: ethernet: mtk_eth_soc: enable the special tag only for the MTK tagger
+
+TX_DMA_SPTAG_V3 and MTK_GDMA_SPECIAL_TAG make the frame engine insert
+and parse the MediaTek special tag. They are currently set whenever
+the netdev is a DSA conduit, regardless of the tagging protocol, and
+MTK_GDMA_SPECIAL_TAG is never cleared once set.
+
+Only DSA_TAG_PROTO_MTK uses that tag format. The RTL8366UB 802.1Q
+tagger carries the port information in a regular 802.1Q tag and needs
+both bits off. Use the existing mtk_uses_dsa() helper, which already
+performs this check (and compiles without CONFIG_NET_DSA), and clear
+MTK_GDMA_SPECIAL_TAG before it is conditionally set again. Move
+mtk_uses_dsa() up so the TX descriptor path can use it.
+
+This changes behaviour for every MediaTek board whose switch uses a
+non-MTK tagger, not only the GL-MT5000:
+ - MT7622 + RTL8365MB (Buffalo WSR-2533DHP2, Elecom WRC-2533GENT,
+   TOTOLINK A8000RU): GDMA special tag off
+ - MT7981 + RTL8365MB (Mercusys MR85x): GDMA special tag off
+ - MT7988 + MxL86282 with mxl862xx-8021q (SmartRG SDG-9000): GDMA
+   special tag and TX SPTAG_V3 off
+These boards need a Tested-by before this is merged.
+
+Split out of the RTL8366UB PPE offload patch as requested in review.
+---
+--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
++++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+@@ -1540,6 +1540,16 @@ static void mtk_tx_set_dma_desc_v1(struc
+ 	WRITE_ONCE(desc->txd4, data);
+ }
+ 
++static bool mtk_uses_dsa(struct net_device *dev)
++{
++#if IS_ENABLED(CONFIG_NET_DSA)
++	return netdev_uses_dsa(dev) &&
++	       dev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_MTK;
++#else
++	return false;
++#endif
++}
++
+ static void mtk_tx_set_dma_desc_v2(struct net_device *dev, void *txd,
+ 				   struct mtk_tx_dma_desc_info *info)
+ {
+@@ -1582,7 +1592,7 @@ static void mtk_tx_set_dma_desc_v2(struc
+ 		/* tx checksum offload */
+ 		if (info->csum)
+ 			data |= TX_DMA_CHKSUM_V2;
+-		if (mtk_is_netsys_v3_or_greater(eth) && netdev_uses_dsa(dev))
++		if (mtk_is_netsys_v3_or_greater(eth) && mtk_uses_dsa(dev))
+ 			data |= TX_DMA_SPTAG_V3;
+ 	}
+ 	WRITE_ONCE(desc->txd5, data);
+@@ -3749,30 +3759,20 @@ static void mtk_gdm_config(struct mtk_et
+ 	val = mtk_r32(eth, MTK_GDMA_FWD_CFG(id));
+ 
+ 	/* default setup the forward port to send frame to PDMA */
+-	val &= ~0xffff;
++	val &= ~(0xffff | MTK_GDMA_SPECIAL_TAG);
+ 
+ 	/* Enable RX checksum */
+ 	val |= MTK_GDMA_ICS_EN | MTK_GDMA_TCS_EN | MTK_GDMA_UCS_EN;
+ 
+ 	val |= config;
+ 
+-	if (eth->netdev[id] && netdev_uses_dsa(eth->netdev[id]))
++	if (eth->netdev[id] && mtk_uses_dsa(eth->netdev[id]))
+ 		val |= MTK_GDMA_SPECIAL_TAG;
+ 
+ 	mtk_w32(eth, val, MTK_GDMA_FWD_CFG(id));
+ }
+ 
+ 
+-static bool mtk_uses_dsa(struct net_device *dev)
+-{
+-#if IS_ENABLED(CONFIG_NET_DSA)
+-	return netdev_uses_dsa(dev) &&
+-	       dev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_MTK;
+-#else
+-	return false;
+-#endif
+-}
+-
